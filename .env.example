TZ=UTC
SERVICE_VERSION=dev
# Weather Service (Open-Meteo)
WEATHER_PROVIDER=open-meteo
WEATHER_LAT=60.3279
WEATHER_LON=25.0542
WEATHER_TIMEZONE=Europe/Helsinki

#Forecast ranges
WEATHER_FORECAST_DAYS=7

# Cache (seconds)
WEATHER_CACHE_TTL_SECONDS=900

# Units (Open-Meteo defaults are fine, but we make it explicit) 
WEATHER_TEMPERATURE_UNIT=celsius 
WEATHER_WIND_SPEED_UNIT=kmh
WATHER_PRECIPITATION_UNIT=mm
WATHER_TIMEFORMAT=iso8601

#Opetinal: models=auto lets Open-meteo choose best blend
WEATHER_MODELS=auto
